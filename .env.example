# =============================================================================
# Pancreatic Cancer Detection - Environment Configuration
# =============================================================================

# Project Base Directory (Optional, defaults to project root)
# BASE_DIR=

# Custom Data Directory (Useful for large external drives, e.g. D:/CT_Data)
# DATA_DIR=

# Custom Models Directory (Optional)
# MODELS_DIR=

# Custom Results Directory (Optional)
# RESULTS_DIR=

# Web Application Settings
HOST=127.0.0.1
PORT=8000
DEBUG=false
APP_ENV=development

# Model Execution
DEFAULT_MODEL=resnet50
USE_GPU=true
MIXED_PRECISION=false
