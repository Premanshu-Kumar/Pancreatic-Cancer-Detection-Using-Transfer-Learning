# =============================================================================
# Pancreatic Cancer Detection - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Project Paths (Optional overrides, defaults to project directory layout)
# -----------------------------------------------------------------------------
# BASE_DIR=/path/to/project
# DATA_DIR=/path/to/data
# RAW_DATA_DIR=/path/to/data/raw
# PROCESSED_DATA_DIR=/path/to/data/processed
# SAMPLE_DATA_DIR=/path/to/data/sample
# MODELS_DIR=/path/to/models
# RESULTS_DIR=/path/to/results
# NOTEBOOKS_DIR=/path/to/notebooks

# -----------------------------------------------------------------------------
# 2. Web Application & Server Settings
# -----------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
APP_ENV=development
MAX_UPLOAD_SIZE_MB=10

# -----------------------------------------------------------------------------
# 3. Model Selection & Acceleration
# -----------------------------------------------------------------------------
DEFAULT_MODEL=resnet50
USE_GPU=true
MIXED_PRECISION=false

# -----------------------------------------------------------------------------
# 4. Training Hyperparameters & Data Configuration
# -----------------------------------------------------------------------------
BATCH_SIZE=32
EPOCHS_PHASE1=15
EPOCHS_PHASE2=20
LEARNING_RATE_PHASE1=0.0001
LEARNING_RATE_PHASE2=0.00001
OPTIMIZER=adam
LOSS_FUNCTION=binary_crossentropy
RANDOM_SEED=42

# -----------------------------------------------------------------------------
# 5. Remote Storage & Git LFS / Model Checkpoints
# -----------------------------------------------------------------------------
HF_MODEL_REPO=premanshu/pancreatic-cancer-resnet50
MODEL_DOWNLOAD_TIMEOUT=300
